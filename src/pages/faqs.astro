---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import TrainRule from '../components/TrainRule.astro';
import { rel } from '../lib/rel';

const r = (p: string) => rel(Astro.url, p);

// Answers as plain text for schema; html for the page where a link helps.
const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: "Can I order online?",
    a: "Orders are by phone, 508.226.1600, Monday to Friday 8 to 4:30 Eastern. You'll talk to a person who can answer anything about your layout before you spend a dime. There's also a printable order form if you'd rather mail or fax it.",
    html: `Orders are by phone, <a href="tel:+15082261600">508.226.1600</a>, Monday to Friday 8 to 4:30 Eastern. You'll talk to a person who can answer anything about your layout before you spend a dime. There's also a <a href="${r('pdfs/order-form.pdf')}" target="_blank" rel="noopener">printable order form</a> if you'd rather mail or fax it.`,
  },
  {
    q: "There doesn't seem to be a kit for the layout I want to build. What should I do?",
    a: "Call us. Mianne Benchwork can be configured to fit just about anywhere, and our design service is free with no obligation. Send a track plan, your room dimensions, or the layout dimensions you have in mind. We'll design a kit that works and quote you a price. Every kit, stock or custom, comes with a detailed color-coded assembly plan.",
  },
  {
    q: "How is Mianne shipped, and what does shipping cost?",
    a: "Factory direct by UPS Ground. The largest box is 8\" x 8\" x 48\" and the average box weighs under 50 lbs. Shipping is 12.5% of the order on orders of $200 and up, and 18% on orders under $200 ($20 minimum). That covers the continental US. For Alaska, Hawaii, and Canada, call for a quote.",
  },
  {
    q: "How do I pay?",
    a: "MasterCard, Visa, AMEX, Discover, or a check made out to Mianne Foley Woodworking. Sales tax of 6.25% applies to Massachusetts orders only.",
  },
  {
    q: "Can I get a height other than the standard 40 inches?",
    a: "Yes. Standard is 40\". Legs come in 42\" to 48\" in 2\" steps, and 58\" for second levels. Any custom height is available at no extra charge. Just tell us when you order. Legs over 46\" carry a shipping surcharge because they need longer boxes.",
  },
  {
    q: "How do I attach the layout to the benchwork?",
    a: "We suggest a plywood base attached with the hardware included in your kit. That way the layout lifts off the benchwork whenever you need it to. Anyone who has ever changed or moved a layout will appreciate it.",
  },
  {
    q: "Does Mianne sell the plywood for the top?",
    a: "No. Buy plywood locally from a building supplier. We recommend 1/2\" interior plywood as a base. Go thicker (3/4\") if you want to overhang the benchwork by a few inches. Pick something flat, and stay away from exterior grades. They're rarely flat or stable.",
  },
  {
    q: "How do I attach risers for different track elevations?",
    a: "Once the plywood base is on, add risers to the plywood wherever you need to raise the track.",
  },
  {
    q: "What are connector blocks and adapter blocks?",
    a: "Connectors attach I-beams to other I-beams, in three directions. Adapters are fillers for attaching crosspieces. The assembly instructions show both in the diagrams.",
  },
  {
    q: "Can I buy one section and add to it later?",
    a: "Yes. Don't think of Mianne as modules. Think of it as legs and I-beams that connect into one unitized structure. For a 2' x 4' section you'd buy a 24B expansion section and a 24LS leg set. For a 2' x 8' section you'd buy two 24B sections but still only one 24LS. That benchwork has six legs total.",
  },
  {
    q: "What's the difference between the 24, 30, and 36 series?",
    a: "The width of the straight sections. Series 24 kits have 24\" wide sections, series 30 have 30\", and series 36 have 36\". Narrower keeps everything in reach. Wider gives you room for deeper scenery and broader curves.",
  },
  {
    q: "Why use I-beams instead of solid wood?",
    a: "Three reasons. Stability: every piece of solid wood moves differently with the seasons. Our I-beams have an engineered core with a hardwood frame, so every piece moves the same way, and that means more reliable track. Consistency: the I-beams are made on dedicated machines, so the tolerances are the same every time and assembly is easy. Weight: they're strong without being heavy, which makes building easier and keeps shipping costs down.",
  },
  {
    q: "How much weight can Mianne support?",
    a: "Any scale, plus all the scenery you want to put on it. With the plywood top attached, Mianne easily supports the weight of an average adult.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Benchwork Questions Answered | Mianne Benchwork"
  description="Sizes, heights, shipping, payment and assembly questions about Mianne model railroad benchwork."
  ogImage="images/hero-about.jpg"
  schema={[faqSchema]}
  preloadImage={{ href: 'images/hero-about.avif', srcset: `${r('images/hero-about-960.avif')} 960w, ${r('images/hero-about.avif')} 1920w`, type: 'image/avif' }}
>
  <PageHero
    title="Frequently Asked Questions"
    sub="Straight answers about sizes, heights, shipping, and ordering Mianne benchwork."
    image="hero-about"
    alt="Stacks of finished Mianne I-beams and legs in the shop, ready to box and ship"
  />

  <section class="section faq-section">
    <div class="wrap narrow">
      <h2 class="reveal">Model railroad benchwork questions</h2>
      <p class="reveal faq-lede">If your question isn't here, call <a href="tel:+15082261600">508.226.1600</a>. You'll get Tim.</p>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class:list={['faq__item reveal', { 'is-open': i === 0 }]}>
            <h3>
              <button class="faq__q-btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-panel-${i}`}>
                <span class="faq__q">{f.q}</span>
                <span class="faq__icon" aria-hidden="true">+</span>
              </button>
            </h3>
            <div class="faq__panel" id={`faq-panel-${i}`}>
              <div class="faq__panel-inner"><div class="faq__a"><p set:html={f.html ?? f.a} /></div></div>
            </div>
          </div>
        ))}
      </div>
      <TrainRule />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Stone band so the white question cards read as distinct objects. */
  .faq-section { background: var(--stone); }
  .faq-section .faq-lede { color: var(--forest); }
  .faq-section .faq-lede a { font-weight: 600; }

  .faq { margin-top: 32px; display: grid; gap: 12px; }
  .faq__item {
    position: relative;
    background: var(--snow);
    border: 1px solid rgba(28, 58, 19, 0.22);
    border-radius: var(--radius-input);
    transition: opacity 0.6s var(--ease), border-color 0.3s var(--ease), background-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .faq__item:hover { border-color: rgba(28, 58, 19, 0.5); transform: translateY(-2px); }
  .faq__item.is-open { border-color: var(--forest); box-shadow: inset 4px 0 0 var(--forest); }

  .faq__item h3 { margin: 0; }
  .faq__q-btn {
    all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 20px; min-height: 48px;
  }
  .faq__q-btn:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; border-radius: var(--radius-input); }
  .faq__q { font-size: 18px; font-weight: 600; line-height: 1.4; color: var(--forest); letter-spacing: -0.005em; }

  .faq__icon {
    flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--forest); color: var(--forest);
    font: 400 22px/1 var(--font-body);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .faq__item.is-open .faq__icon { background: var(--forest); color: var(--snow); transform: rotate(135deg); }

  /* Height slides open and shut (grid 0fr to 1fr), same as the LWS FAQ. */
  .faq__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }
  .faq__panel-inner { overflow: hidden; opacity: 0; transition: opacity 0.3s var(--ease); }
  .faq__item.is-open .faq__panel-inner { opacity: 1; }
  :global(.no-js) .faq__panel { grid-template-rows: 1fr; }
  :global(.no-js) .faq__panel-inner { opacity: 1; }

  .faq__a { padding: 0 20px 20px; }
  .faq__a p { margin: 0; color: #1a2416; font-size: 17px; line-height: 1.7; }
  .faq__a a { color: var(--forest); font-weight: 600; text-decoration-thickness: 1.5px; }

  /* FAQ effects (same as livewebstudios.com/faq): decode, typed answer, scan line. */
  :global(.faq-fx-q.is-decoding) { color: var(--pewter); }
  :global(.faq-fx-a .faq-w) { opacity: 0; transition: opacity 0.14s linear; }
  :global(.faq-fx-a.is-typing .faq-w) { opacity: 1; }
  .faq__item:global(.is-scanning)::after {
    content: ''; position: absolute; top: -1px; left: 0; width: 100%; height: 2px; z-index: 2; pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, var(--eucalyptus) 50%, transparent 100%);
    background-size: 220% 100%;
    animation: faq-scan 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes faq-scan {
    0% { opacity: 1; background-position: 100% 0; }
    100% { opacity: 0; background-position: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__item, .faq__icon, .faq__panel, .faq__panel-inner { transition: none; }
    .faq__item:hover { transform: none; }
  }
</style>

<script>
  // Accordion: any number of answers can be open at once.
  document.querySelectorAll<HTMLElement>('.faq__item').forEach(function (item) {
    var btn = item.querySelector<HTMLButtonElement>('.faq__q-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var willOpen = !item.classList.contains('is-open');
      item.classList.toggle('is-open', willOpen);
      btn!.setAttribute('aria-expanded', String(willOpen));
      item.dispatchEvent(new Event('faq:toggle'));
    });
  });

  (function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var GLYPHS = '01<>/_#*+=:;[]{}';
    var DECODE_MS = 1400, STAGGER_MS = 160, LINE_MS = 420;

    type Item = { el: HTMLElement; q: HTMLElement | null; a: HTMLElement | null; vis?: HTMLElement; text?: string; words?: HTMLElement[] };
    var items: Item[] = [];
    document.querySelectorAll<HTMLElement>('.faq__item').forEach(function (el) {
      items.push({ el: el, q: el.querySelector('.faq__q'), a: el.querySelector('.faq__a p') });
    });
    if (!items.length) return;
    var isOpen = function (it: Item) { return it.el.classList.contains('is-open'); };

    /* 1. Question decode */
    function prepQuestion(it: Item) {
      var q = it.q;
      if (!q || q.dataset.faqFx) return;
      q.dataset.faqFx = '1';
      var text = (q.textContent || '').trim();
      var real = document.createElement('span');
      real.className = 'visually-hidden';
      real.textContent = text;
      var vis = document.createElement('span');
      vis.className = 'faq-fx-q';
      vis.setAttribute('aria-hidden', 'true');
      vis.textContent = text;
      q.textContent = '';
      q.appendChild(real);
      q.appendChild(vis);
      it.vis = vis;
      it.text = text;
    }
    function decode(it: Item, delay: number) {
      if (!it.vis || !it.text) return;
      var vis = it.vis, text = it.text, t0 = performance.now() + delay;
      vis.classList.add('is-decoding');
      function tick(t: number) {
        var k = Math.max(0, Math.min(1, (t - t0) / DECODE_MS));
        var n = Math.floor(text.length * k);
        var tail = '';
        for (var i = n; i < text.length; i++) {
          tail += text[i] === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        }
        vis.textContent = text.slice(0, n) + tail;
        if (k < 1) requestAnimationFrame(tick);
        else { vis.textContent = text; vis.classList.remove('is-decoding'); }
      }
      requestAnimationFrame(tick);
    }

    /* 2. Answer typing, swept line by line */
    function prepAnswer(it: Item) {
      var p = it.a;
      if (!p || p.dataset.faqFx) return;
      p.dataset.faqFx = '1';
      Array.prototype.slice.call(p.childNodes).forEach(function (child: ChildNode) {
        if (child.nodeType === 3) {
          var frag = document.createDocumentFragment();
          (child.textContent || '').split(/(\s+)/).forEach(function (part) {
            if (!part) return;
            if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
            var w = document.createElement('span');
            w.className = 'faq-w';
            w.textContent = part;
            frag.appendChild(w);
          });
          child.replaceWith(frag);
        } else if (child.nodeType === 1) {
          (child as HTMLElement).classList.add('faq-w'); // links type in as one word
        }
      });
      it.words = Array.prototype.slice.call(p.querySelectorAll('.faq-w'));
      p.classList.add('faq-fx-a');
    }
    function type(it: Item) {
      var p = it.a;
      if (!p || !it.words) return;
      p.classList.remove('is-typing');
      it.words.forEach(function (w) { w.style.transitionDelay = ''; });
      var rows: { top: number; words: HTMLElement[] }[] = [];
      it.words.forEach(function (w) {
        var top = w.offsetTop, row = null;
        for (var i = 0; i < rows.length; i++) if (Math.abs(rows[i].top - top) < 4) { row = rows[i]; break; }
        if (!row) rows.push((row = { top: top, words: [] }));
        row.words.push(w);
      });
      rows.sort(function (a, b) { return a.top - b.top; });
      var pw = p.clientWidth || 1;
      rows.forEach(function (r, i) {
        r.words.forEach(function (w) {
          w.style.transitionDelay = Math.round(i * LINE_MS + (w.offsetLeft / pw) * LINE_MS) + 'ms';
        });
      });
      void p.offsetWidth;
      p.classList.add('is-typing');
    }
    function untype(it: Item) { if (it.a) it.a.classList.remove('is-typing'); }

    /* 3. Scan line */
    function scan(it: Item) {
      var el = it.el;
      el.classList.remove('is-scanning');
      void el.offsetWidth;
      el.classList.add('is-scanning');
      setTimeout(function () { el.classList.remove('is-scanning'); }, 950);
    }

    items.forEach(function (it) {
      prepQuestion(it);
      prepAnswer(it);
      // The first item starts open; show its answer rather than leaving it blank.
      if (isOpen(it) && it.a) it.a.classList.add('is-typing');
      it.el.addEventListener('faq:toggle', function () {
        if (isOpen(it)) { type(it); scan(it); } else untype(it);
      });
    });

    // Decode the questions the first time the list scrolls into view.
    var list = document.querySelector('.faq');
    if (!list || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        items.forEach(function (it, k) { decode(it, k * STAGGER_MS); });
        io.disconnect();
      });
    }, { threshold: 0.2 });
    io.observe(list);
  })();
</script>

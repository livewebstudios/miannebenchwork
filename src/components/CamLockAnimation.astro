---
/**
 * The cam-and-dowel joint, drawn and animated by hand in SVG. A cutaway side view.
 *
 * Everything is drawn in its FINAL, assembled position. The beam animates in from
 * a negative translate. The steel dowel is threaded into the leg and never moves.
 *
 * The geometry is exact: the cam's spiral channel starts at the rim (r = R) and
 * spirals in to r = R - PULL over exactly 180 degrees. The cam turns with the
 * beam's last PULL units of travel, so the dowel head sits at the same point in
 * space the whole time while the channel draws the beam onto it. That last bit
 * of travel is the cam closing the joint, which is the whole point.
 *
 * With no JS, or with reduced motion, the markup is already the final frame.
 */
const CX = 490; // cam centre, assembled
const CY = 220;
const R = 36; // cam radius
const PULL = 26; // travel produced by the half turn
const SLIDE = 120; // approach travel before the cam engages

// Spiral channel in the cam's own frame: at turn angle a (0..180), the head sits
// at radius R - PULL * a/180 and local angle -a, which the rotation maps back to 0.
const pts = [[R + 8, 0]];
for (let a = 0; a <= 180; a += 15) {
  const r = R - (PULL * a) / 180;
  const t = (a * Math.PI) / 180;
  pts.push([r * Math.cos(t), -r * Math.sin(t)]);
}
const channel = 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L');
const headX = CX + R - PULL; // 500: where the dowel head lives, always
---

<figure class="cam" data-cam data-cx={CX} data-pull={PULL} data-slide={SLIDE}>
  <div class="cam-stage">
    <svg viewBox="250 14 560 410" role="img" aria-labelledby="cam-t cam-d" class="cam-svg">
      <title id="cam-t">How a Mianne cam-lock joint closes</title>
      <desc id="cam-d">
        Cutaway side view. A hardwood I-beam slides onto a steel dowel threaded into a hardwood
        leg. A screwdriver seats in the cam barrel inside the end of the beam and turns it
        exactly one half turn. The spiral channel in the cam draws the dowel head toward its
        center, pulling the beam the last inch onto the leg until the joint is flush and square.
      </desc>
      <defs>
        <linearGradient id="cw" x2="0" y2="1">
          <stop offset="0" stop-color="#ecdcb8"></stop><stop offset=".55" stop-color="#e0cb9f"></stop><stop offset="1" stop-color="#cfb685"></stop>
        </linearGradient>
        <linearGradient id="cl" x2="1">
          <stop offset="0" stop-color="#eedfbd"></stop><stop offset=".5" stop-color="#e0cb9f"></stop><stop offset="1" stop-color="#c9ad7a"></stop>
        </linearGradient>
        <linearGradient id="cs" x2="0" y2="1">
          <stop offset="0" stop-color="#f4f5f6"></stop><stop offset=".4" stop-color="#c9cdd0"></stop><stop offset=".75" stop-color="#8e9295"></stop><stop offset="1" stop-color="#dfe2e4"></stop>
        </linearGradient>
        <clipPath id="cc"><circle r={R}></circle></clipPath>
      </defs>

      <line x1="250" y1="410" x2="800" y2="410" stroke="#d6d6cf" stroke-width="2"></line>
      <g font-family="'JetBrains Mono',ui-monospace,monospace" font-size="12.5" letter-spacing="1.6" fill="#666666">
        <text x="266" y="398">CUTAWAY</text>
        <text x="610" y="26" text-anchor="middle">LEG</text>
        <text x="548" y="136" text-anchor="end">STEEL DOWEL</text>
      </g>

      <!-- Leg, fixed. Pocket cut away to show the threaded bore. -->
      <rect x="560" y="36" width="100" height="374" rx="2" fill="url(#cl)"></rect>
      <rect x="560" y="202" width="54" height="36" fill="#eeeee9"></rect>
      <rect x="560" y="36" width="100" height="374" rx="2" fill="none" stroke="#8a7350" stroke-width="2.5"></rect>
      <rect x="560" y="212" width="48" height="16" fill="url(#cs)"></rect>
      <path d="M566 212l6 16M574 212l6 16M582 212l6 16M590 212l6 16M598 212l6 16" stroke="#787e82" stroke-width="1.5"></path>

      <!-- I-beam, slides in -->
      <g data-cam-beam>
        <rect x="40" y="150" width="520" height="22" fill="url(#cw)"></rect>
        <rect x="40" y="172" width="410" height="96" fill="#d4bd92"></rect>
        <rect x="40" y="268" width="520" height="22" fill="url(#cw)"></rect>
        <rect x="440" y="150" width="120" height="140" fill="url(#cw)"></rect>
        <rect x="448" y="174" width="112" height="92" fill="#e6d3aa"></rect>
        <circle cx={CX} cy={CY} r={R + 2} fill="#eeeee9"></circle>
        <rect x={CX} y="210" width={560 - CX} height="20" fill="#eeeee9"></rect>
        <path d={`M${CX} 172v6M${CX} 262v6`} stroke="#698e79" stroke-width="2.5"></path>
        <rect x="40" y="150" width="520" height="140" fill="none" stroke="#8a7350" stroke-width="2.5"></rect>
        <path d="M440 150v140M448 174h112M448 266h112M448 174v92" fill="none" stroke="#8a7350" stroke-width="1.2"></path>
        <g font-family="'JetBrains Mono',ui-monospace,monospace" font-size="12.5" letter-spacing="1.6" fill="#666666">
          <text x="300" y="314">HARDWOOD I-BEAM</text>
          <text x={CX} y="314" text-anchor="middle">CAM</text>
        </g>
      </g>

      <!-- Cam barrel, rides with the beam and turns. Final frame: half turn done. -->
      <g data-cam-barrel transform={`translate(${CX} ${CY}) rotate(180)`}>
        <circle r={R} fill="url(#cs)" stroke="#6f7376" stroke-width="2"></circle>
        <path d={channel} clip-path="url(#cc)" fill="none" stroke="#3d4346" stroke-opacity=".7" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"></path>
        <rect x="-19" y="-3.5" width="38" height="7" rx="1.5" fill="#2f3437"></rect>
        <circle cy="-29" r="3.6" fill="#698e79"></circle>
      </g>

      <!-- Dowel shank and head, fixed to the leg -->
      <rect x={headX} y="213" width={560 - headX} height="14" fill="url(#cs)" stroke="#8e9295"></rect>
      <circle cx={headX} cy={CY} r="10" fill="url(#cs)" stroke="#5f6568" stroke-width="1.5"></circle>

      <!-- Screwdriver, comes in at an angle from in front of the page -->
      <g data-cam-driver opacity="0" transform={`translate(${CX} ${CY}) rotate(-35)`}>
        <path d="M-5 0h10l-1-12h-8z" fill="#5f6568"></path>
        <rect x="-5" y="-122" width="10" height="112" fill="url(#cs)"></rect>
        <rect x="-16" y="-236" width="32" height="118" rx="9" fill="#1c3a13"></rect>
        <rect data-cam-glint x="-10" y="-228" width="7" height="102" rx="3.5" fill="#3d6a2e"></rect>
      </g>

      <!-- Flush and square -->
      <g data-cam-square fill="none" stroke="#698e79" stroke-width="2.5">
        <path d="M530 290v28h30"></path>
        <path d="M528 145h64"></path>
      </g>
    </svg>
    <p class="cam-caption" data-cam-caption aria-hidden="true">Tight, flush and square.</p>
  </div>

  <div class="cam-controls" data-cam-controls hidden>
    <button class="cam-btn" type="button" data-cam-toggle>PLAY</button>
    <label class="cam-scrub">
      <span class="visually-hidden">Scrub through the joint closing</span>
      <input type="range" min="0" max="1000" value="1000" data-cam-range />
    </label>
  </div>
</figure>

<style>
  .cam {
    margin: 0;
  }

  .cam-stage {
    background: var(--cream-deep);
    border-radius: var(--radius);
    padding: clamp(0.75rem, 3vw, 2.5rem) clamp(0.75rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
  }

  .cam-svg {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .cam-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown);
    min-height: 1.5em;
  }

  .cam-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .cam-controls[hidden] {
    display: none;
  }

  .cam-btn {
    flex: 0 0 auto;
    min-width: 96px;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--brown);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--brown);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .cam-btn:hover {
    background: var(--brown);
    color: var(--cream);
  }

  .cam-scrub {
    flex: 1 1 auto;
  }

  .cam-scrub input {
    display: block;
    width: 100%;
    height: 44px;
    accent-color: var(--brown);
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-cam]');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var q = function (s) { return root.querySelector(s); };
    var beam = q('[data-cam-beam]'), barrel = q('[data-cam-barrel]'), driver = q('[data-cam-driver]');
    var glint = q('[data-cam-glint]'), square = q('[data-cam-square]'), cap = q('[data-cam-caption]');
    var btn = q('[data-cam-toggle]'), range = q('[data-cam-range]');
    var CX = +root.dataset.cx, PULL = +root.dataset.pull, SLIDE = +root.dataset.slide;
    var DUR = 6000, HOLD = 2400;

    var clamp = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
    var seg = function (t, a, b) { return clamp((t - a) / (b - a)); };
    var ease = function (p) { return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2; };
    var CAPS = [[0, 'Slide the beam onto the dowel.'], [0.29, 'Seat the screwdriver in the cam.'], [0.44, 'One half turn.'], [0.8, 'Tight, flush and square.']];

    var t = 0, playing = false, held = false, t0 = 0, raf = 0;

    function render(v) {
      t = v;
      var turn = ease(seg(v, 0.45, 0.78));
      var x = -(SLIDE + PULL) + ease(seg(v, 0, 0.27)) * SLIDE + turn * PULL;
      var dIn = ease(seg(v, 0.29, 0.41)), dOut = ease(seg(v, 0.83, 0.93));
      var off = 230 * (1 - dIn) + 230 * dOut;
      beam.setAttribute('transform', 'translate(' + x.toFixed(2) + ' 0)');
      barrel.setAttribute('transform', 'translate(' + (CX + x).toFixed(2) + ' 220) rotate(' + (turn * 180).toFixed(2) + ')');
      driver.setAttribute('transform', 'translate(' + (CX + x - 0.574 * off).toFixed(2) + ' ' + (220 - 0.819 * off).toFixed(2) + ') rotate(-35)');
      driver.setAttribute('opacity', Math.min(1, dIn * 1.6) * (1 - dOut));
      glint.setAttribute('x', (-10 + 13 * Math.sin(turn * Math.PI)).toFixed(2));
      square.setAttribute('opacity', ease(seg(v, 0.84, 0.95)));
      var c = CAPS[0][1];
      for (var i = 0; i < CAPS.length; i++) if (v >= CAPS[i][0]) c = CAPS[i][1];
      if (cap.textContent !== c) cap.textContent = c;
      if (document.activeElement !== range) range.value = Math.round(v * 1000);
    }

    function frame(now) {
      var e = now - t0;
      if (e > DUR + HOLD) { t0 = now; e = 0; }
      render(clamp(e / DUR));
      raf = requestAnimationFrame(frame);
    }

    function play() {
      if (playing) return;
      playing = true;
      t0 = performance.now() - (t >= 1 ? 0 : t * DUR);
      btn.textContent = 'PAUSE';
      raf = requestAnimationFrame(frame);
    }

    function pause() {
      playing = false;
      cancelAnimationFrame(raf);
      btn.textContent = 'PLAY';
    }

    btn.addEventListener('click', function () {
      if (playing) { held = true; pause(); } else { held = false; play(); }
    });
    range.addEventListener('input', function () {
      held = true;
      pause();
      render(range.value / 1000);
    });

    q('[data-cam-controls]').hidden = false;
    render(0);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting && !held) play();
          else if (!e.isIntersecting) pause();
        });
      }, { threshold: 0.35 }).observe(root);
    } else play();
  })();
</script>

---
// Facade: a thumbnail and play button. The iframe loads only when someone asks for it.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="yt" data-yt={id}>
  <button class="yt__btn" type="button" aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="yt__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" focusable="false"><path d="M66.5 7.7c-.8-2.9-3-5.2-5.9-6C55.4.3 34 .3 34 .3s-21.4 0-26.6 1.4c-2.9.8-5.1 3.1-5.9 6C.1 13 .1 24 .1 24s0 11 1.4 16.3c.8 2.9 3 5.2 5.9 6C12.6 47.7 34 47.7 34 47.7s21.4 0 26.6-1.4c2.9-.8 5.1-3.1 5.9-6 1.4-5.3 1.4-16.3 1.4-16.3s0-11-1.4-16.3z" /><path class="yt__tri" d="M45 24 27 14v20z" /></svg>
    </span>
    <span class="yt__title">{title}</span>
  </button>
</div>
<style>
  .yt { position: relative; aspect-ratio: 16 / 9; background: var(--brown-dark); border-radius: var(--radius); overflow: hidden; }
  .yt__btn { all: unset; position: absolute; inset: 0; cursor: pointer; display: block; }
  .yt__btn:focus-visible { outline: 2px solid var(--lime); outline-offset: -4px; }
  .yt img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transition: opacity 0.3s; }
  .yt__btn:hover img { opacity: 1; }
  .yt__play { position: absolute; left: 50%; top: 50%; width: 76px; transform: translate(-50%, -50%); }
  .yt__play path:first-child { fill: var(--forest); transition: fill 0.2s; }
  .yt__btn:hover .yt__play path:first-child { fill: var(--forest-hover); }
  .yt__play .yt__tri { fill: var(--snow); }
  .yt__title { position: absolute; left: 0; right: 0; bottom: 0; padding: 32px 18px 14px; color: var(--cream-text); font-weight: 500; font-size: 15px; background: rgba(36, 25, 18, 0.72); padding-top: 14px; }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script is:inline>
  document.querySelectorAll('[data-yt]').forEach(function (el) {
    var btn = el.querySelector('button');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', function () {
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + el.dataset.yt + '?autoplay=1&rel=0';
      f.title = btn.getAttribute('aria-label').replace('Play video: ', '');
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      el.innerHTML = '';
      el.appendChild(f);
    });
  });
</script>

---
import { rel } from '../lib/rel';
import { money } from '../lib/catalog';
interface Props { href: string; image: string; label: string; sub: string; from?: number | null; count?: number }
const { href, image, label, sub, from, count } = Astro.props;
const r = (p: string) => rel(Astro.url, p);
---
<a class="tile reveal" href={r(href)}>
  <div class="tile__img">
    <picture>
      <source type="image/avif" srcset={r(`images/${image}-960.avif`)} />
      <source type="image/webp" srcset={r(`images/${image}-960.webp`)} />
      <img src={r(`images/${image}-960.jpg`)} alt="" width="960" height="536" loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="tile__body">
    <span class="tile__label">{label}</span>
    <span class="tile__sub">{sub}{count ? ` · ${count} models` : ''}</span>
    {from != null && <span class="tile__from spec"><small>FROM</small>{money(from)}</span>}
  </div>
</a>
